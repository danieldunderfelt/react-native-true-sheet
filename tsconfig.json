{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@danieldunderfelt/react-native-true-sheet": ["./src/index"],
      "@danieldunderfelt/react-native-true-sheet/reanimated": ["./src/reanimated/index"],
      "@danieldunderfelt/react-native-true-sheet/navigation": ["./src/navigation/index"],
      "@danieldunderfelt/react-native-true-sheet/navigation/expo-router": ["./src/navigation/expo-router/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["jest", "node"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["lib", "build", "docs"]
}
